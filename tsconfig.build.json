{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "sourceMap": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "tests/**/*.ts",
    "examples/**/*.ts",
    "dist",
    "node_modules",
    "src/adapters/desk/client-src",
    "src/adapters/desk/islands-src"
  ]
}
