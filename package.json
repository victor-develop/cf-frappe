{
  "name": "cf-frappe",
  "version": "0.1.0",
  "description": "A metadata-driven, event-sourced application framework for Cloudflare Workers.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "import": "./dist/cloudflare/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cf-frappe": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "coverage": "vitest run --coverage",
    "coverage:naming": "vitest run --coverage --config vitest.naming-coverage.config.ts",
    "coverage:all": "vitest run --coverage --config vitest.full-coverage.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:client": "node scripts/build-desk-client.mjs",
    "check:client-fresh": "npm run build:client && git diff --exit-code -- src/adapters/desk/client-bundle.generated.ts",
    "check": "npm run lint && npm run test && npm run build",
    "up": "node scripts/local-up.mjs",
    "dev": "wrangler dev --persist-to=.wrangler/state",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply cf-frappe-dev --local",
    "d1:migrate:remote": "wrangler d1 migrations apply cf-frappe-dev --remote"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "frappe",
    "event-sourcing",
    "durable-objects",
    "d1",
    "metadata-driven"
  ],
  "dependencies": {
    "hono": "^4.13.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "0.28.1",
    "happy-dom": "20.11.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.119.0"
  }
}
